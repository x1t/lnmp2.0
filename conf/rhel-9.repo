[baseos]
name=CentOS Stream $releasever - BaseOS
baseurl=https://mirror.math.princeton.edu/pub/centos-stream/9-stream/BaseOS/$basearch/os/
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=1
metadata_expire=6h
countme=1
enabled=1

[appstream]
name=CentOS Stream $releasever - AppStream
baseurl=https://mirror.math.princeton.edu/pub/centos-stream/9-stream/AppStream/$basearch/os/
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=1
metadata_expire=6h
countme=1
enabled=1

[crb]
name=CentOS Stream $releasever - CRB
baseurl=https://mirror.math.princeton.edu/pub/centos-stream/9-stream/CRB/$basearch/os/
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official
gpgcheck=1
repo_gpgcheck=1
metadata_expire=6h
countme=1
enabled=1
