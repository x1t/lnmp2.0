# CentOS-Base.repo
#
# The mirror system uses the connecting IP address of the client and the
# update status of each mirror to pick mirrors that are updated to and
# geographically close to the client.  You should use this for CentOS updates
# unless you are manually picking other mirrors.
#
# If the mirrorlist= does not work for you, as a fall back you can try the 
# remarked out baseurl= line instead.
#
#
 
[base]
name=CentOS-8.5.2111 - Base - mirror.lt.ucsc.edu
baseurl=https://mirror.lt.ucsc.edu/centos/8.5.2111/BaseOS/$basearch/os/
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official
 
#additional packages that may be useful
[extras]
name=CentOS-8.5.2111 - Extras - mirror.lt.ucsc.edu
baseurl=https://mirror.lt.ucsc.edu/centos/8.5.2111/extras/$basearch/os/
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official
 
#additional packages that extend functionality of existing packages
[centosplus]
name=CentOS-8.5.2111 - Plus - mirror.lt.ucsc.edu
baseurl=https://mirror.lt.ucsc.edu/centos/8.5.2111/centosplus/$basearch/os/
gpgcheck=1
repo_gpgcheck=1
enabled=0
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official
 
[PowerTools]
name=CentOS-8.5.2111 - PowerTools - mirror.lt.ucsc.edu
baseurl=https://mirror.lt.ucsc.edu/centos/8.5.2111/PowerTools/$basearch/os/
gpgcheck=1
repo_gpgcheck=1
enabled=0
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official


[AppStream]
name=CentOS-8.5.2111 - AppStream - mirror.lt.ucsc.edu
baseurl=https://mirror.lt.ucsc.edu/centos/8.5.2111/AppStream/$basearch/os/
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://www.centos.org/keys/RPM-GPG-KEY-CentOS-Official
